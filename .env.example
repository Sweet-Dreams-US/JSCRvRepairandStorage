# ─────────────────────────────────────────────────────────────
# JSC RV Service — environment configuration
# Copy this file to `.env.local` (dev) and set the real values in
# your Vercel project settings (Production / Preview) before launch.
# ─────────────────────────────────────────────────────────────

# ── Auth ──────────────────────────────────────────────────────
# Secret used to HMAC-sign session cookies so they can't be forged.
# Generate one with:  openssl rand -base64 32
# REQUIRED in production — the app FAILS CLOSED (refuses to sign sessions)
# if this is missing or shorter than 16 chars, rather than falling back to
# an insecure, source-visible secret.
AUTH_SECRET=

# Password for the owner/admin sign-in on /login.
# When set, the "Owner sign-in" form on /login works.
# When empty, only demo accounts (if DEMO_MODE) can sign in.
ADMIN_PASSWORD=

# One-click demo accounts + role-switcher (passwordless).
# In PRODUCTION this is OFF unless you explicitly set DEMO_MODE=true — the
# sales-demo deploy sets it true. In dev it's on unless set to "false".
# For Joe's real deployment, leave it unset so demo login stays disabled.
DEMO_MODE=true

# ── Inquiry emails (Resend) ───────────────────────────────────
# API key from https://resend.com/api-keys
# When empty, inquiries are still saved to the admin panel and the
# email step is skipped (logged, never errors).
RESEND_API_KEY=

# Where new inquiries are delivered.
INQUIRY_TO_EMAIL=joe@jscrvrepair.com

# The From address. Must be on a domain you've verified in Resend.
# Until the domain is verified you can use Resend's sandbox sender
# (onboarding@resend.dev), which only delivers to the account owner.
# Once jscrvrepair.com is verified in Resend, switch to e.g.
#   "JSC RV Service <inquiries@jscrvrepair.com>"
INQUIRY_FROM_EMAIL="JSC RV Service <onboarding@resend.dev>"

# ── Supabase (customer access codes / requests / updates) ─────
# From your Supabase project → Project Settings → API.
# When SUPABASE_SERVICE_ROLE_KEY is empty, the customer-access feature
# runs on the in-memory store (works, but not persisted).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret — server-side only, never exposed to the browser:
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ──────────────────────────────────────────────────────
# Canonical/primary domain, used for SEO + Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://jscrvrepair.com
